{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ai_teach_redis_schema_v2",
  "title": "师范专业 AI 试讲台系统 Redis 键空间定义",
  "version": "2.0",
  "generated_from": "设计文档.md V2.0 §3.1 / §9",
  "meta": {
    "app": "ai_teach",
    "env_placeholder": "{env}",
    "env_enum": ["prod", "staging", "dev"],
    "naming_convention": "<app>:<env>:<module>:<biz>:<id>",
    "redis_version": "8.10.2",
    "encoding": "UTF-8",
    "timestamp_unit": "epoch_ms",
    "time_zone": "UTC",
    "generated_at": "2026-10-25"
  },
  "global_policy": {
    "persistence": {
      "runtime_instance": { "appendonly": "yes", "appendfsync": "everysec", "rdb_schedule": ["save 3600 1", "save 300 100", "save 60 10000"] },
      "cache_instance":   { "appendonly": "no",  "rdb_schedule": [] }
    },
    "maxmemory_policy": {
      "runtime_instance": "noeviction",
      "cache_instance":   "allkeys-lru"
    },
    "maxmemory_rationale": "锁与序号绝不可淘汰；缓存由 TTL 与 LRU 控制；两实例物理隔离（§9 硬规则）",
    "instance_layout": {
      "runtime_instance": { "prefixes": ["ai_teach:{env}:classroom:session:*", "ai_teach:{env}:evaluation:lock:*"], "db_index": { "dev": 0, "staging": 1, "prod": 2 } },
      "cache_instance":   { "prefixes": ["ai_teach:{env}:leaderboard:*", "ai_teach:{env}:task:cache:*"],             "db_index": { "dev": 0, "staging": 1, "prod": 2 } }
    },
    "auth": { "acl_user": "ai_teach_app", "note": "密码与 ACL 由环境变量注入，禁止硬编码" }
  },
  "serialization": {
    "hash_field_value": "UTF-8 字符串；对象字段为紧凑 JSON 字符串（无空格）",
    "string_json": "紧凑 JSON，UTF-8；字段顺序按 keys[].fields 定义",
    "zset_score": "IEEE 754 double，分数保留两位小数",
    "boolean": "0 / 1",
    "enum": "英文代码，与 MySQL ENUM 代码一致",
    "datetime": "ISO 8601 UTC，YYYY-MM-DDTHH:MM:SS.sssZ",
    "uuid": "36 位小写带连字符",
    "null_in_hash": "字段不存在表示 NULL；禁止写入空串表示 NULL"
  },
  "keys": [
    {
      "name": "session_state",
      "pattern": "ai_teach:{env}:classroom:session:state:{session_id}",
      "module": "classroom",
      "biz": "session:state",
      "id_placeholder": "{session_id}",
      "instance": "runtime_instance",
      "type": "hash",
      "purpose": "试讲会话运行态镜像（trial_session 全字段）",
      "status": "confirmed",
      "writer": "virtual-classroom-service",
      "readers": ["virtual-classroom-service", "evaluation-service", "frontend"],
      "rebuild_from": "classroom.trial_session 按 session_id 单行",
      "rebuild_note": "可完整重建；MySQL 为权威",
      "ttl": { "seconds": 6300, "rule": "会话最长 2700s + 3600s 余量", "refresh_on_write": true, "refresh_command": "EXPIRE key 6300" },
      "expiry_policy": "TTL 自然过期；场次结束后主动 DEL 或保留至 TTL 供复盘",
      "fields": [
        { "field": "session_id",          "type": "string", "format": "uuid", "nullable": false, "source": "trial_session.session_id" },
        { "field": "task_id",             "type": "string", "format": "uuid", "nullable": true,  "source": "trial_session.task_id" },
        { "field": "user_id",             "type": "string", "format": "uuid", "nullable": false, "source": "trial_session.user_id" },
        { "field": "mode",                "type": "string", "format": "enum", "enum": ["free","scenario","structured"], "nullable": false, "source": "trial_session.mode" },
        { "field": "scenario_id",         "type": "string", "format": "uuid", "nullable": true,  "source": "trial_session.scenario_id" },
        { "field": "topic_id",            "type": "string", "format": "uuid", "nullable": true,  "source": "trial_session.topic_id" },
        { "field": "student_count",       "type": "string", "format": "int",  "nullable": false, "source": "trial_session.student_count" },
        { "field": "behavior_intensity",  "type": "string", "format": "enum", "enum": ["low","mid","high"], "nullable": false, "source": "trial_session.behavior_intensity" },
        { "field": "classroom_theme",     "type": "string", "format": "enum", "enum": ["blackboard","ppt","multimedia","kindergarten"], "nullable": false, "source": "trial_session.classroom_theme" },
        { "field": "bgm_level",           "type": "string", "format": "enum", "enum": ["off","light","standard"], "nullable": false, "source": "trial_session.bgm_level" },
        { "field": "planned_duration_s",  "type": "string", "format": "int",  "nullable": false, "source": "trial_session.planned_duration_s" },
        { "field": "actual_duration_s",   "type": "string", "format": "int",  "nullable": true,  "source": "trial_session.actual_duration_s" },
        { "field": "start_at",            "type": "string", "format": "datetime", "nullable": true, "source": "trial_session.start_at" },
        { "field": "end_at",              "type": "string", "format": "datetime", "nullable": true, "source": "trial_session.end_at" },
        { "field": "status",              "type": "string", "format": "enum", "enum": ["not_started","running","paused","finished","aborted"], "nullable": false, "source": "trial_session.status" },
        { "field": "device_info",         "type": "string", "format": "json", "nullable": true,  "source": "trial_session.device_info" },
        { "field": "consent_id",          "type": "string", "format": "uuid", "nullable": false, "source": "trial_session.consent_id" },
        { "field": "engine_tick_ms",      "type": "string", "format": "int",  "nullable": false, "source": "运行态：服务端心跳时间戳（无对应列），用于活性判定" }
      ],
      "key_risk": {
        "big_key": "否：约 18 字段 × ≤200B ≈ 4KB",
        "hot_key": "是：单场次高频写",
        "mitigation": "服务端 200ms 合并写；读走本地二级缓存；场次结束 DEL"
      }
    },
    {
      "name": "session_seq",
      "pattern": "ai_teach:{env}:classroom:session:seq:{session_id}",
      "module": "classroom",
      "biz": "session:seq",
      "id_placeholder": "{session_id}",
      "instance": "runtime_instance",
      "type": "string",
      "value_format": "int",
      "purpose": "场次内消息序号，前端按 seq 去重/排序",
      "status": "confirmed",
      "writer": "virtual-classroom-service（INCR）",
      "readers": ["frontend"],
      "rebuild_from": "无法重建；丢失即从 1 重新计数",
      "ttl": { "seconds": 3600, "rule": "每次 INCR 后刷新；上限 1h", "refresh_command": "EXPIRE key 3600" },
      "expiry_policy": "TTL",
      "key_risk": { "big_key": "否", "hot_key": "中（INCR 轻量）", "mitigation": "无需" }
    },
    {
      "name": "eval_lock",
      "pattern": "ai_teach:{env}:evaluation:lock:eval:{session_id}",
      "module": "evaluation",
      "biz": "lock:eval",
      "id_placeholder": "{session_id}",
      "instance": "runtime_instance",
      "type": "string",
      "value_format": "uuid（token）",
      "purpose": "评测流水线互斥锁，防重复评测",
      "status": "confirmed",
      "writer": "evaluation-service",
      "readers": ["evaluation-service"],
      "rebuild_from": "无需重建",
      "ttl": { "seconds": 1800, "rule": "看门狗每 600s 续期一次；最长持有 30min" },
      "expiry_policy": "Lua 比较 token 后 DEL；TTL 兜底防死锁",
      "lua_release": "if redis.call('GET', KEYS[1]) == ARGV[1] then return redis.call('DEL', KEYS[1]) else return 0 end",
      "key_risk": { "big_key": "否", "hot_key": "否", "mitigation": "无" }
    },
    {
      "name": "leaderboard_rank",
      "pattern": "ai_teach:{env}:leaderboard:rank:{scope}:{scope_id}:{period_key}",
      "module": "leaderboard",
      "biz": "rank",
      "id_placeholder": "{scope}:{scope_id}:{period_key}",
      "instance": "cache_instance",
      "type": "zset",
      "purpose": "周期排行榜实时镜像",
      "status": "confirmed",
      "writer": "growth-cert-service（定时重建 + 增量 ZADD）",
      "readers": ["growth-cert-service", "frontend"],
      "rebuild_from": "growth_cert.leaderboard WHERE scope=? AND scope_id=? AND period_key=?",
      "ttl": { "rule": "EXPIREAT = 周期末 UTC + 7d", "compute": "period_end_utc + 7*86400", "example_2026_10": 1794096000 },
      "expiry_policy": "EXPIREAT",
      "members": {
        "member": { "type": "string", "format": "uuid", "description": "user_id" },
        "score":  { "type": "double", "description": "榜单分数 0–100，两位小数" }
      },
      "constraints": {
        "scope_enum": ["class", "grade", "major", "school"],
        "period_key_format": ["YYYY-MM-DD（day）", "YYYY-Www（week）", "YYYY-MM（month）", "YYYY-Sn（term）"],
        "tie_breaker": "同分按 user_id 字典序，由重建作业统一分配"
      },
      "key_risk": { "big_key": "否（单榜 ≤1 万 member）", "hot_key": "中（热门班/校榜）", "mitigation": "读缓存 + 页面级缓存" }
    },
    {
      "name": "topic_cache",
      "pattern": "ai_teach:{env}:task:cache:topic:{topic_id}",
      "module": "task",
      "biz": "cache:topic",
      "id_placeholder": "{topic_id}",
      "instance": "cache_instance",
      "type": "string",
      "value_format": "json",
      "purpose": "trial_topic 行缓存，降低题库读压力",
      "status": "confirmed",
      "writer": "task-content-service",
      "readers": ["task-content-service", "virtual-classroom-service"],
      "rebuild_from": "task_content.trial_topic 按 topic_id 单行",
      "ttl": { "seconds": 3600, "jitter_ratio": 0.1, "rule": "基础 3600s + 0~10% 随机抖动" },
      "expiry_policy": "TTL；题目更新时主动 DEL",
      "json_fields": [
        "topic_id", "subject_id", "stage", "textbook_version", "book_volume", "chapter",
        "topic_title", "content_text", "requirements", "difficulty", "source", "exam_year", "usage_count"
      ],
      "cache_guard": { "max_bytes": 8192, "rule": "序列化后 >8KB 不缓存" },
      "key_risk": { "big_key": "中（content_text 5000 字 ≈15KB，临界）", "hot_key": "是（热门题）", "mitigation": "超 8KB 不缓存；TTL 抖动" }
    }
  ],
  "proposed_keys": [
    {
      "name": "ratelimit_api",
      "pattern": "ai_teach:{env}:gateway:ratelimit:{subject_id}:{window}",
      "type": "string",
      "purpose": "接口限流计数器（建议项，文档未定义，需确认）",
      "status": "proposed"
    },
    {
      "name": "eval_stream",
      "pattern": "ai_teach:{env}:evaluation:stream:{queue_name}",
      "type": "stream",
      "purpose": "评测流水线任务队列（建议项，文档未指定中间件，需确认）",
      "status": "proposed"
    }
  ]
}