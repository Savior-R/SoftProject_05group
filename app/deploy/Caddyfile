# A1 回环入口；跨机器/生产需按09/G6另行验证可信HTTPS与TURN。
:8080 {
    encode zstd gzip
    @backend path /api/* /ws/* /health/* /healthz /openapi.json /docs /docs/* /redoc
    handle @backend {
        reverse_proxy api:8000
    }
    handle /internal/* {
        respond 404
    }
    handle {
        root * /srv/frontend
        try_files {path} /index.html
        file_server
    }
}
