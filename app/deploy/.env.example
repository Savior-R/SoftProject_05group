# 复制为 .env；填写实际连接。不要提交 .env，或把真实配置输出到日志。
ENV=demo
DEBUG=false
READINESS_TIMEOUT_S=2
DB_DIALECT=mysql
# 容器中127.0.0.1指向容器自身；复用宿主SQL时使用host.docker.internal。
# DATABASE_URL=mysql+aiomysql://USER:URL_ENCODED_PASSWORD@host.docker.internal:3307/identity_org?charset=utf8mb4
DATABASE_URL=
JWT_SIGNING_KEY=
# staging/prod 必须提供至少32字符随机密钥，且DEBUG=false；正式生产使用ENV=prod。

# 以下业务配置尚须按对应实施步骤接入；列出键名不表示功能已完成。
QUEUE_BACKEND=memory
STORAGE_BACKEND=local
MEDIA_ROOT=/app/runtime/media
JWT_ISSUER=ai-teach
JWT_AUDIENCE=web
ACCESS_TTL_S=7200
REFRESH_TTL_S=604800
AI_MODE=rules
GLM_API_KEY=
GLM_BASE_URL=
GLM_TEXT_MODEL=
GLM_VISION_MODEL=
GLM_ASR_MODEL=
