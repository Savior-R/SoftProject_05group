# 复制为本机 .env 后填写；样例没有真实 secret，禁止提交实际 .env。
ENV=demo
DEBUG=false
READINESS_TIMEOUT_S=2

# 留空时 live=200、ready=503；仅配置 DSN 不会直接变为 ready。
# 同步业务使用PyMySQL；独立探针由公共配置适配为aiomysql，不参与业务事务。
# 旧mysql+aiomysql格式兼容，推荐新配置明确使用pymysql。
# DATABASE_URL=mysql+pymysql://USER:URL_ENCODED_PASSWORD@127.0.0.1:PORT/identity_org?charset=utf8mb4
DATABASE_URL=
DB_DIALECT=mysql
# 七域物理库名前缀：空=逻辑库名；隔离库组可用test_<组名>_。
DB_SCHEMA_PREFIX=
# 专用迁移账号，同实例/端口/入口库且不同于业务账号；API部署不要注入此凭据。
MIGRATION_DATABASE_URL=
TEST_DB_SCHEMA_PREFIX=test_
# 独立测试库，仅允许 test_ 加七个逻辑域名；增强 Step 1 必填，切勿填共享开发库。
# TEST_DATABASE_URL=mysql+aiomysql://USER:URL_ENCODED_PASSWORD@127.0.0.1:PORT/test_identity_org?charset=utf8mb4
TEST_DATABASE_URL=

# staging/prod 必须提供至少 32 字符的随机 JWT_SIGNING_KEY。
# 当前最小后端尚未实现登录/JWT/GLM 业务，只校验和保护这些配置。
JWT_SIGNING_KEY=
GLM_API_KEY=

# 后续步骤配置清单；此处列出键名不代表相关业务已经实现。
QUEUE_BACKEND=memory
STORAGE_BACKEND=local
# 使用本机私有媒体目录的绝对路径；当前健康探针不读取它。
MEDIA_ROOT=
JWT_ISSUER=ai-teach
JWT_AUDIENCE=web
ACCESS_TTL_S=7200
REFRESH_TTL_S=604800
AI_MODE=rules
GLM_BASE_URL=
GLM_TEXT_MODEL=
GLM_VISION_MODEL=
GLM_ASR_MODEL=

