# 复制为本机 .env 后填写；样例没有真实 secret，禁止提交实际 .env。
ENV=demo
DEBUG=false
READINESS_TIMEOUT_S=2

# 留空时 live=200、ready=503；仅配置 DSN 不会直接变为 ready。
# 本次仅实现 MySQL 异步运维探针，包含 RSA 认证依赖；业务 Session 后续按 ADR-010 实施。
# DATABASE_URL=mysql+aiomysql://USER:URL_ENCODED_PASSWORD@127.0.0.1:PORT/identity_org?charset=utf8mb4
DATABASE_URL=
DB_DIALECT=mysql
# 独立测试库，仅允许 test_ 加七个逻辑域名；增强 Step 1 必填，切勿填共享开发库。
# TEST_DATABASE_URL=mysql+aiomysql://USER:URL_ENCODED_PASSWORD@127.0.0.1:PORT/test_identity_org?charset=utf8mb4
TEST_DATABASE_URL=

# staging/prod 必须提供至少 32 字符的随机 JWT_SIGNING_KEY。
# 当前最小后端尚未实现登录/JWT/GLM 业务，只校验和保护这些配置。
JWT_SIGNING_KEY=
GLM_API_KEY=

# 后续步骤配置清单；此处列出键名不代表相关业务已经实现。
QUEUE_BACKEND=memory
STORAGE_BACKEND=local
# 使用本机私有媒体目录的绝对路径；当前健康探针不读取它。
MEDIA_ROOT=
JWT_ISSUER=ai-teach
JWT_AUDIENCE=web
ACCESS_TTL_S=7200
REFRESH_TTL_S=604800
AI_MODE=rules
GLM_BASE_URL=
GLM_TEXT_MODEL=
GLM_VISION_MODEL=
GLM_ASR_MODEL=

